    "instrument": "Regulation (EU) 2018/1806",
    "instrumentTitle": "Regulation (EU) 2018/1806 of the European Parliament and of the Council of 14 November 2018 listing the third countries whose nationals must be in possession of visas when crossing the external borders and those whose nationals are exempt from that requirement",
    "consolidatedVersion": "2025-12-30",
    "consolidatedVersionLabel": "Consolidated text 32018R1806 EN, 30 December 2025",
    "celex": "02018R1806-20251230",
    "url": "https://eur-lex.europa.eu/eli/reg/2018/1806/",
    "consolidatedUrl": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02018R1806-20251230",
    "retrieved": "2026-09-12",
    "annexes": {
      "Annex I": "Third countries whose nationals are required to hold a visa when crossing the external borders of the Member States.",
      "Annex II": "Third countries whose nationals are exempt from that requirement for stays of no more than 90 days in any 180 day period."
    },
    "freeMovementNote": "Nationals of the EU, the EEA and Switzerland appear in neither annex. Their category here comes from free movement rules, not from Regulation (EU) 2018/1806.",
    "scope": "Short stays for tourism and similar purposes, up to 90 days in any 180 day period, in the Schengen area. It does not cover work, study, residence or any long stay.",
    "note": "Conditions are quoted from the footnotes to the annexes of the consolidated regulation. Where an entry is conditional, the condition is the headline, not a footnote."
  },
  "categories": {
    "free_movement": "No visa and no ETIAS. Free movement rights apply with no time limit under the Schengen short stay rules.",
    "exempt": "No short stay visa needed for up to 90 days in any 180 day period.",
    "exempt_conditional": "No short stay visa needed for up to 90 days in any 180 day period, but only if a condition is met.",
    "visa_required": "A Schengen short stay visa is required."
  },
