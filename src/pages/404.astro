---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 Page Not Found | DURIAN Travel"
  description="The page you are looking for does not exist. Visit our homepage or browse our blog for European travel planning guides and resources."
  noindex={true}
  keywords="404 error, page not found, DURIAN travel"
>
  <section class="hero-sm hero-gradient">
    <div class="container">
      <span class="section-label" style="color:var(--color-accent-light)">Error 404</span>
      <h1 class="hero-sm__title" style="color:white">This page does not exist</h1>
      <p class="hero-sm__subtitle">
        It may have moved, or the link that brought you here may be out of date. These will get you
        back on track.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow">
      <div class="not-found__links">
        <a href="/" class="btn btn--primary">Back to the homepage</a>
        <a href="/tools/" class="btn btn--secondary">Planners</a>
        <a href="/blog/" class="btn btn--ghost" style="color:var(--color-primary);border-color:var(--color-border)">Blog</a>
      </div>
      <div class="not-found__popular">
        <p>Popular pages:</p>
        <ul>
          <li><a href="/schengen-visa-guide/" class="link">Schengen Complete Guide</a></li>
          <li><a href="/contact/" class="link">Contact Us</a></li>
          <li><a href="/faq/" class="link">Frequently Asked Questions</a></li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.hero-sm { padding-block: var(--space-16); }
.hero-sm__title { font-family: var(--font-serif); font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl)); margin-bottom: var(--space-4); }
.hero-sm__subtitle { font-size: var(--text-lg); color: hsla(0, 0%, 100%, 0.85); max-width: 60ch; line-height: var(--leading-relaxed); }
.not-found__links    { display: flex; gap: var(--space-4); flex-wrap: wrap; margin-bottom: var(--space-8); }
.not-found__popular  { color: var(--color-text-muted); }
.not-found__popular p { font-size: var(--text-sm); margin-bottom: var(--space-3); }
.not-found__popular ul { display: flex; gap: var(--space-4); flex-wrap: wrap; }
.not-found__popular li { font-size: var(--text-sm); }
</style>
