---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABanner from '../../components/CTABanner.astro';
import { serviceHrefByOldSlug, servicePackages, servicePositioning } from '../../data/service-pages';

// The package data has one home: src/data/service-packages.json, surfaced through
// service-pages.ts. This page used to keep a second hand-written copy of all of
// it, which is how the retired document-review wording survived here after it
// was removed elsewhere. Derive it instead so the two can never drift again.
const packages = servicePackages.map((pkg) => ({
  slug: pkg.oldSlug,
  tier: pkg.tier,
  name: pkg.name,
  sub: pkg.sub,
  icon: pkg.icon,
  tone: pkg.tone,
  badge: pkg.badge,
  target: pkg.target,
  tagline: pkg.tagline,
  included: pkg.included,
  differentiators: pkg.differentiators,
  healthLabel: pkg.health_layer.label,
  healthCredential: pkg.health_layer.credential,
  healthItems:
    pkg.health_layer.items.length > 1
      ? `${pkg.health_layer.items.slice(0, -1).join(', ')}, and ${pkg.health_layer.items.slice(-1)[0]}.`
      : `${pkg.health_layer.items[0]}.`,
  addons: pkg.addons,
  geo: pkg.geo_customization.map((region) => ({
    region: region.segment,
    items: region.items,
  })),
}));

const serviceSchema = packages.map((pkg) => ({
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: pkg.name,
  description: pkg.tagline,
  provider: {
    '@type': 'Organization',
    name: 'DURIAN Travel',
    url: 'https://www.duriantravel.com',
  },
  url: `https://www.duriantravel.com${serviceHrefByOldSlug[pkg.slug]}`,
  areaServed: ['Europe', 'North America', 'South America', 'Africa', 'Asia', 'Australia'],
}));

const tierGroups = [
  {
    label: 'Starting a journey',
    packages: packages.filter((pkg) => pkg.tier === 'Starting a journey'),
  },
  {
    label: 'Managing complexity',
    packages: packages.filter((pkg) => pkg.tier === 'Managing complexity'),
  },
  {
    label: 'Premium & multi-region',
    packages: packages.filter((pkg) => pkg.tier === 'Premium & multi-region'),
  },
];

const breadcrumb = [{ name: 'Services', url: 'https://www.duriantravel.com/services/' }];
---

<BaseLayout
  title="Trip Planning Packages for Travellers From Outside Europe | DURIAN Travel"
  description="Compare Durian Travel packages for Schengen trip planning, first international trips, family travel, travel health planning, digital nomads, and multi-region journeys."
  breadcrumb={breadcrumb}
  schema={serviceSchema}
  keywords="europe trip planning package, itinerary planning package, pharmacist-backed travel planning, schengen planning package, first-time international travel package, travel wellness planning"
>
  <section class="hero-sm hero-gradient">
    <div class="container services-hero">
      <span class="section-label services-hero__label">Trip Planning + Visa Guidance</span>
      <h1 class="hero-sm__title services-hero__title">Choose the package that fits your level of complexity</h1>
      <p class="hero-sm__subtitle services-hero__subtitle">
        {servicePositioning} These packages are grouped by the kind of complexity you are actually
        managing, not by generic destination buckets.
      </p>
      <div class="services-hero__actions">
        <a href="/contact/" class="btn btn--primary">Start by Writing to Us</a>
        <a href="#packages" class="btn btn--secondary">Compare the Packages</a>
      </div>
      <p class="services-hero__note">
        We provide educational planning support: route logic, budgets, timing, and health-aware
        preparation. We do not review your documents, we do not submit applications on your behalf,
        and the consulate alone decides the outcome.
      </p>
    </div>
  </section>

  <section class="section" id="packages">
    <div class="container">
      <div class="notice notice--info mb-8">
        <span aria-hidden="true">📍</span>
        <p>
          <strong>Quick way to choose:</strong> start with <strong>Schengen Blueprint</strong> if the
          Schengen process itself is the confusing part, <strong>First Journey</strong> if this is your
          first international trip, <strong>Family Expedition</strong> if you are coordinating several
          travellers at once, <strong>Nomad Infrastructure</strong> if you are staying past 90 days, and
          <strong>Wellness Journey</strong> if health should drive the plan from day one.
        </p>
      </div>

      <div class="package-picker">
        <div class="package-picker__header">
          <div>
            <span class="section-label">Choose a Package</span>
            <h2 class="package-picker__title">Six packages, grouped by trip complexity</h2>
          </div>
          <p class="package-picker__copy">
            Every package combines visa logic, route planning, and a pharmacist-informed health layer.
            Choose the track that matches your real bottleneck, then open the dedicated package page for the full fit.
          </p>
        </div>

        <div class="package-tier-list" role="tablist" aria-label="Durian Travel packages">
          {tierGroups.map((group) => (
            <section class="package-tier">
              <span class="package-tier__label">{group.label}</span>
              <div class={`package-grid package-grid--${group.packages.length}`}>
                {group.packages.map((pkg, index) => (
                  <button
                    id={`tab-${pkg.slug}`}
                    class={`package-tab package-tab--${pkg.tone}`}
                    type="button"
                    role="tab"
                    aria-selected={packages[0].slug === pkg.slug ? 'true' : 'false'}
                    aria-controls={pkg.slug}
                    tabindex={packages[0].slug === pkg.slug ? '0' : '-1'}
                    data-package-button={pkg.slug}
                  >
                    {pkg.badge && <span class={`package-badge package-badge--${pkg.tone}`}>{pkg.badge}</span>}
                    <span class="package-tab__name">{pkg.name}</span>
                    <span class="package-tab__sub">{pkg.sub}</span>
                  </button>
                ))}
              </div>
            </section>
          ))}
        </div>

        <div class="package-panels">
          {packages.map((pkg) => (
            <section
              id={pkg.slug}
              class={`package-panel package-panel--${pkg.tone}`}
              role="tabpanel"
              aria-labelledby={`tab-${pkg.slug}`}
              data-package-panel={pkg.slug}
              hidden={packages[0].slug !== pkg.slug}
            >
              <div class="package-panel__header">
                <div class="package-panel__accent" aria-hidden="true">{pkg.icon}</div>
                <div>
                  <h3 class="package-panel__title">{pkg.name}</h3>
                  <p class="package-panel__tagline">{pkg.tagline}</p>
                </div>
              </div>

              <div class="package-panel__section">
                <span class="section-label">Ideal Client</span>
                <p class="package-panel__target">{pkg.target}</p>
              </div>

              <div class="package-health">
                <div class="package-health__heading">
                  <span class="package-health__credential">{pkg.healthCredential}</span>
                  <strong class="package-health__title">{pkg.healthLabel}</strong>
                </div>
                <p class="package-health__copy">{pkg.healthItems}</p>
              </div>

              <div class="package-panel__columns">
                <div>
                  <span class="section-label">What&apos;s Included</span>
                  <div class="package-card">
                    {pkg.included.map((item) => <p class="package-item">{item}</p>)}
                  </div>
                </div>
                <div>
                  <span class="section-label">Why You Can't Get This Elsewhere</span>
                  <div class="package-card package-card--spaced">
                    {pkg.differentiators.map((item) => <p class="package-item package-item--check">{item}</p>)}
                  </div>
                  <span class="section-label">Optional Add-ons</span>
                  <div class="package-addon-row">
                    {pkg.addons.map((item) => <span class="package-addon">{item}</span>)}
                  </div>
                </div>
              </div>

              <div class="package-panel__section">
                <span class="section-label">Tailored By Region</span>
                <div class="package-geo-grid">
                  {pkg.geo.map((region) => (
                    <div class="package-geo-card">
                      <h4 class="package-geo-card__title">{region.region}</h4>
                      {region.items.map((item) => <p class="package-geo-card__item">{item}</p>)}
                    </div>
                  ))}
                </div>
              </div>

              <div class="package-panel__actions">
                <a href={serviceHrefByOldSlug[pkg.slug]} class="btn btn--primary">View Package Details</a>
                <a href="/contact/" class="btn btn--secondary">Ask About This Package</a>
              </div>
            </section>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tinted">
    <div class="container container--narrow">
      <header class="section-header text-center">
        <span class="section-label">How It Works</span>
        <h2 class="section-title">One package, then a tighter plan</h2>
      </header>
      <div class="services-steps">
        <div class="services-step">
          <span class="services-step__num">01</span>
          <h3 class="services-step__title">Choose your track</h3>
          <p class="services-step__copy">
            Pick the package that best matches where you are actually stuck.
          </p>
        </div>
        <div class="services-step">
          <span class="services-step__num">02</span>
          <h3 class="services-step__title">Send context</h3>
          <p class="services-step__copy">
            You tell us your nationality, your dates, your route and any health or family constraints.
            We do not ask for your documents and we do not look at them.
          </p>
        </div>
        <div class="services-step">
          <span class="services-step__num">03</span>
          <h3 class="services-step__title">Get the plan</h3>
          <p class="services-step__copy">
            You leave with a route that holds together, a budget in euros, and the official sources for
            your own nationality, before money gets locked into the trip.
          </p>
        </div>
      </div>
    </div>
  </section>

  <CTABanner />
</BaseLayout>

<style>
  .hero-sm {
    padding-block: var(--space-16);
  }

  .services-hero {
    max-width: 72rem;
  }

  .services-hero__label {
    color: hsl(150 30% 82%);
  }

  .services-hero__title {
    color: var(--color-text-inverse);
    max-width: 14ch;
  }

  .services-hero__subtitle {
    color: hsl(150 25% 78%);
    max-width: 62ch;
  }

  .services-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .services-hero__note {
    margin-top: var(--space-5);
    font-size: var(--text-sm);
    color: hsl(150 18% 80%);
    max-width: 60ch;
  }

  .package-picker {
    display: grid;
    gap: var(--space-8);
  }

  .package-picker__header {
    display: grid;
    gap: var(--space-4);
    align-items: end;
    grid-template-columns: 1.1fr 0.9fr;
  }

  .package-picker__title {
    font-size: clamp(var(--text-2xl), 4vw, var(--text-3xl));
    line-height: var(--leading-tight);
  }

  .package-picker__copy {
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    max-width: 44ch;
  }

  .package-tier-list {
    display: grid;
    gap: var(--space-6);
  }

  .package-tier {
    display: grid;
    gap: var(--space-3);
  }

  .package-tier__label {
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }

  .package-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--space-3);
  }

  .package-tab {
    appearance: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-4);
    background: var(--color-surface);
    color: var(--color-text);
    text-align: left;
    cursor: pointer;
    display: grid;
    gap: var(--space-1);
    position: relative;
    transition:
      border-color var(--transition-fast),
      background-color var(--transition-fast),
      box-shadow var(--transition-fast),
      transform var(--transition-fast);
  }

  .package-tab:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
  }

  .package-tab:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--color-primary) 35%, transparent);
    outline-offset: 2px;
  }

  .package-tab[aria-selected='true'] {
    border-width: 2px;
    box-shadow: var(--shadow-md);
  }

  .package-tab--blueprint[aria-selected='true'] {
    border-color: var(--color-primary);
    background: var(--color-primary-bg);
  }

  .package-tab--journey[aria-selected='true'] {
    border-color: var(--color-warning);
    background: #fff7e8;
  }

  .package-tab--nomad[aria-selected='true'],
  .package-tab--family[aria-selected='true'],
  .package-tab--circuit[aria-selected='true'] {
    border-color: var(--color-primary-light);
    background: var(--color-bg-alt);
  }

  .package-tab--recovery[aria-selected='true'] {
    border-color: var(--color-error);
    background: #fff0f0;
  }

  .package-tab--wellness[aria-selected='true'] {
    border-color: var(--color-success);
    background: #eef9f3;
  }

  .package-tab__name {
    font-weight: var(--font-semibold);
    font-size: var(--text-sm);
    padding-right: 5rem;
  }

  .package-tab__sub {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .package-badge {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-full);
    font-size: 0.625rem;
    font-weight: var(--font-semibold);
    letter-spacing: 0.03em;
  }

  .package-badge--recovery {
    background: #fff0f0;
    color: var(--color-error);
  }

  .package-badge--wellness {
    background: #eef9f3;
    color: var(--color-success);
  }

  .package-panels {
    display: grid;
  }

  .package-panel {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    background: var(--color-surface);
    padding: clamp(var(--space-6), 3vw, var(--space-8));
    box-shadow: var(--shadow-sm);
  }

  .package-panel--blueprint {
    --package-accent: var(--color-primary);
    --package-surface: var(--color-primary-bg);
  }

  .package-panel--journey {
    --package-accent: var(--color-warning);
    --package-surface: #fff7e8;
  }

  .package-panel--nomad,
  .package-panel--family,
  .package-panel--circuit {
    --package-accent: var(--color-primary-light);
    --package-surface: var(--color-bg-alt);
  }

  .package-panel--recovery {
    --package-accent: var(--color-error);
    --package-surface: #fff0f0;
  }

  .package-panel--wellness {
    --package-accent: var(--color-success);
    --package-surface: #eef9f3;
  }

  .package-panel__header {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-6);
  }

  .package-panel__accent {
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-lg);
    background: var(--package-surface);
    color: var(--package-accent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .package-panel__title {
    font-size: clamp(var(--text-xl), 3vw, var(--text-2xl));
    line-height: var(--leading-tight);
    margin-bottom: var(--space-2);
  }

  .package-panel__tagline,
  .package-panel__target {
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  .package-panel__section {
    margin-bottom: var(--space-6);
  }

  .package-health {
    background: var(--package-surface);
    border-radius: var(--radius-xl);
    padding: var(--space-5);
    margin-bottom: var(--space-6);
  }

  .package-health__heading {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .package-health__credential {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-full);
    background: var(--package-accent);
    color: white;
    font-size: 0.625rem;
    font-weight: var(--font-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .package-health__title {
    color: var(--package-accent);
  }

  .package-health__copy {
    color: color-mix(in srgb, var(--package-accent) 76%, black 24%);
    line-height: var(--leading-relaxed);
    font-size: var(--text-sm);
  }

  .package-panel__columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
    margin-bottom: var(--space-6);
  }

  .package-card {
    background: var(--color-bg-alt);
    border-radius: var(--radius-xl);
    padding: var(--space-5);
  }

  .package-card--spaced {
    margin-bottom: var(--space-4);
  }

  .package-item {
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--color-border-light);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
  }

  .package-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .package-item::before {
    content: '— ';
    color: var(--package-accent);
  }

  .package-item--check::before {
    content: '✓ ';
  }

  .package-addon-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .package-addon {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    background: var(--color-surface);
  }

  .package-geo-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  .package-geo-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-4);
    background: var(--color-surface);
  }

  .package-geo-card__title {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    margin-bottom: var(--space-3);
  }

  .package-geo-card__item {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    padding-block: var(--space-1);
  }

  .package-geo-card__item::before {
    content: '· ';
    color: var(--package-accent);
  }

  .package-panel__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .services-steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .services-step {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
  }

  .services-step__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: var(--radius-full);
    background: var(--color-primary-bg);
    color: var(--color-primary);
    font-weight: var(--font-bold);
    margin-bottom: var(--space-4);
  }

  .services-step__title {
    font-size: var(--text-lg);
    margin-bottom: var(--space-3);
  }

  .services-step__copy {
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  @media (max-width: 900px) {
    .package-picker__header,
    .package-panel__columns,
    .package-geo-grid,
    .services-steps {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .package-panel__header {
      flex-direction: column;
    }

    .services-hero__actions,
    .package-panel__actions {
      flex-direction: column;
    }

    .services-hero__actions .btn,
    .package-panel__actions .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script>
  const buttons = Array.from(document.querySelectorAll('[data-package-button]'));
  const panels = Array.from(document.querySelectorAll('[data-package-panel]'));

  function getValidSlug(slug) {
    return buttons.some((button) => button.dataset.packageButton === slug)
      ? slug
      : buttons[0]?.dataset.packageButton;
  }

  function activatePackage(slug, shouldUpdateHash = true, shouldFocus = shouldUpdateHash) {
    const nextSlug = getValidSlug(slug);
    if (!nextSlug) return;

    buttons.forEach((button) => {
      const isActive = button.dataset.packageButton === nextSlug;
      button.setAttribute('aria-selected', String(isActive));
      button.setAttribute('tabindex', isActive ? '0' : '-1');
      if (isActive && shouldFocus) button.focus({ preventScroll: true });
    });

    panels.forEach((panel) => {
      panel.hidden = panel.dataset.packagePanel !== nextSlug;
    });

    if (shouldUpdateHash && window.location.hash !== `#${nextSlug}`) {
      window.history.replaceState(null, '', `#${nextSlug}`);
    }
  }

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      activatePackage(button.dataset.packageButton);
    });
  });

  window.addEventListener('hashchange', () => {
    activatePackage(window.location.hash.replace('#', ''), false, false);
  });

  activatePackage(window.location.hash.replace('#', ''), false, false);
</script>
