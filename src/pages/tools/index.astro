---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { REPORT_PRICE, offerCta, FULL_REPORT_URL } from '../../data/full-report';

const canonical = 'https://www.duriantravel.com/tools/';

// Everything Durian Travel publishes for planning a trip sits on this page,
// in the order somebody needs it rather than in order of what it costs. The
// report comes first because it is the one thing here that answers the whole
// question, and its price sits on its own card rather than in a section label.
const tools = [
  {
    id: 'report',
    heading: 'The full cost per country report',
    href: FULL_REPORT_URL,
    line: 'Every country you are weighing up, priced against your own budget, and the realistic ways to combine them.',
    detail: [
      'Seven Eurostat price categories instead of one, so a room, a meal out and a week of groceries are each priced where you are going.',
      'It opens on screen as soon as you pay, with every figure sourced and dated.',
    ],
    sections: [
      'Each country on its own, against your budget',
      'The realistic ways to combine those countries',
      'What a day costs in every country',
      'Where every figure comes from, with dates',
    ],
    cta: offerCta,
    paid: true,
  },
  {
    id: 'visa',
    heading: 'Do you need a Schengen visa for your passport?',
    href: '/tools/do-you-need-a-visa/',
    line: 'Pick the passport you will travel on and get a yes or no, read straight from EU law.',
    detail: [
      'One of four answers, with the condition spelled out where an exemption has one.',
      'Every answer shows the version of the regulation used and the date we last checked it.',
    ],
    cta: 'Check your passport',
  },
  {
    id: 'cost',
    heading: 'Cheapest countries in Europe to visit, compared',
    href: '/tools/cost-per-country/',
    line: 'See what the same trip costs in 28 countries, cheapest first.',
    detail: [
      'Choose how you travel and how long for, and every country is priced per day and for the whole trip.',
      'Built on Eurostat price levels, with the dataset and the date shown on the page.',
    ],
    cta: 'Compare countries',
  },
  {
    id: 'budget',
    heading: 'Work out your Europe trip budget',
    href: '/tools/budget/',
    line: 'Put in your own figures and see the total, the cost per person and the cost per day.',
    detail: [
      'It keeps the costs you pay once apart from the ones that repeat every night.',
      'Nothing you type leaves your browser.',
    ],
    cta: 'Work out your budget',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'How much a trip to Europe costs',
  url: canonical,
  description:
    'The cost per country report, plus free planners for visa requirements, country costs and your own trip budget.',
};
---

<BaseLayout
  title="How Much a Trip to Europe Costs | DURIAN Travel"
  description="What a trip to Europe costs before you book: a report priced against your own budget, plus free planners for visa rules, country costs and your trip budget."
  canonical={canonical}
  schema={schema}
  keywords="how much does a trip to europe cost, cheapest countries in europe to visit, do i need a schengen visa, europe trip budget calculator"
  breadcrumb={[{ name: 'Planners', url: canonical }]}
>
  <section class="hero-sm hero-gradient">
    <div class="container">
      <span class="section-label" style="color:var(--color-accent-light)">Planners</span>
      <h1 class="hero-sm__title" style="color:white">How much a trip to Europe costs, before you book anything</h1>
      <p class="hero-sm__subtitle">
        One report and three planners, built on published price data and EU law rather than on guesses.
      </p>
      <p class="hero-sm__note">
        We do not run consultations or review documents. Everything here is a tool you use yourself.
      </p>
    </div>
  </section>

  <div class="container">
    <Breadcrumb items={[{ name: 'Planners' }]} />
  </div>

  <section class="section section--sm">
    <div class="container container--narrow" id="tools-directory">
      {tools.map((tool) => (
        <article class={`tool${tool.paid ? ' tool--paid' : ''}`} id={tool.id}>
          <h2 class="tool__heading"><a href={tool.href}>{tool.heading}</a></h2>
          <p class="tool__line">{tool.line}</p>
          {tool.paid && <p class="tool__price">{REPORT_PRICE}</p>}
          <ul class="tool__detail" role="list">
            {tool.detail.map((line) => <li>{line}</li>)}
          </ul>
          {tool.sections && (
            <>
              <p class="tool__sections-title">What is in it</p>
              <ol class="tool__sections" role="list">
                {tool.sections.map((section) => <li>{section}</li>)}
              </ol>
            </>
          )}
          <p class="tool__actions">
            <a class={tool.paid ? 'btn btn--primary' : 'tool__link'} href={tool.href}>
              {tool.cta}{tool.paid ? '' : ' →'}
            </a>
          </p>
        </article>
      ))}

      <section class="sources" aria-labelledby="sources-heading">
        <h2 class="tool__heading" id="sources-heading">Where these figures come from</h2>
        <p class="tool__line">
          Every planner shows the data it used and the date it was read. Nothing here is generated,
          estimated in secret, or left undated.
        </p>
        <p class="sources__links">
          <a href="/methodology/">How these figures are produced →</a>
          <a href="/sources/">Every source, with the date it was checked →</a>
        </p>
      </section>

      <p class="tools-disclaimer">
        Educational information only. Not legal advice. Always check the official embassy or
        consulate source.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-sm { padding-block: var(--space-16); }
  .hero-sm__title {
    font-family: var(--font-serif);
    font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
    margin-bottom: var(--space-4);
    max-width: 22ch;
  }
  .hero-sm__subtitle {
    font-size: var(--text-lg);
    color: hsla(0, 0%, 100%, 0.85);
    max-width: 60ch;
    line-height: var(--leading-relaxed);
  }
  .hero-sm__note {
    margin-top: var(--space-3);
    font-size: var(--text-base);
    color: hsla(0, 0%, 100%, 0.72);
    max-width: 60ch;
    line-height: var(--leading-relaxed);
  }

  /* One block per thing, in the order a reader needs them. No grouping by
     price: the price belongs to the report's own block. */
  .tool {
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--color-border);
  }
  .tool--paid {
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    background: var(--color-bg-alt);
    margin-bottom: var(--space-6);
  }
  .tool__heading {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--text-2xl);
    color: var(--color-navy);
    margin: 0 0 var(--space-2);
    line-height: 1.25;
  }
  .tool__heading a { color: inherit; text-decoration: none; }
  .tool__heading a:hover { color: var(--color-primary); }
  .tool__line {
    margin: 0 0 var(--space-3);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
  }
  .tool__price {
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    color: var(--color-primary);
    margin: 0 0 var(--space-3);
  }
  .tool__detail {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-4);
    display: grid;
    gap: var(--space-2);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
  }
  .tool__sections-title {
    margin: 0 0 var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-heading);
  }
  .tool__sections {
    margin: 0 0 var(--space-4);
    padding-left: var(--space-5);
    display: grid;
    gap: var(--space-1);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
  }
  .tool__actions { margin: 0; }
  .tool__link { font-weight: var(--font-semibold); color: var(--color-primary); }

  .sources { padding: var(--space-6) 0; }
  .sources__links {
    margin: 0;
    display: grid;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }
  .sources__links a { font-weight: var(--font-semibold); color: var(--color-primary); }

  .tools-disclaimer {
    margin-top: var(--space-8);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }
</style>
