---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import costData from '../../data/country-costs.json';
import { REPORT_PRICE, offerCta, reportIncludes, styles, FULL_REPORT_URL } from '../../data/full-report';

const canonical = 'https://www.duriantravel.com/tools/cost-per-country/';

// Two layers on one page.
//
// The free comparison scales an editorial daily figure by each country's
// Eurostat price level index for restaurants and hotels, where the EU27
// average is 100. There is no reference country to pick: the reference is
// permanently the EU average, so nothing a visitor touches can rescale the
// other 27 bars. That was a real defect and it is why the "at prices like"
// dropdown is gone.
//
// The full report asks how somebody actually travels and weights seven
// Eurostat categories instead of one. It lives on its own page at
// /tools/cost-per-country/full-report/, is generated server side by
// /api/report, and is never built into this page. This page only shows the
// offer and links to it.
const source = costData._source;
const countries = costData.countries;

// The price, the offer copy and the styles come from src/data/full-report.ts,
// shared with the full report page, so each is defined exactly once.

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Europe Cost-per-Country Estimator',
  url: canonical,
  applicationCategory: 'TravelApplication',
  operatingSystem: 'Any',
  description:
    'Compare what the same trip costs across European countries, using Eurostat price level indices for restaurants and hotels.',
};
---

<BaseLayout
  title="Europe Cost-per-Country Estimator | DURIAN Travel"
  description="See what the same daily budget buys in each European country, based on official Eurostat price levels for restaurants and hotels. Compare 28 countries, no sign-up."
  canonical={canonical}
  schema={schema}
  keywords="cheapest countries in europe to visit, cost of travel by country europe, europe daily budget by country"
  breadcrumb={[{ name: 'Cost per country', url: canonical }]}
>
  <script define:vars={{ FULL_REPORT_URL }}>
    // Stripe used to return people to this page. The report now lives on its
    // own page, so anybody arriving here with a session id is forwarded there
    // with it, rather than landing on a page that no longer takes payment.
    if (/[?&]session_id=/.test(location.search)) {
      location.replace(FULL_REPORT_URL + location.search + location.hash);
    }
  </script>
  <div class="container">
    <Breadcrumb items={[{ name: 'Planners', href: '/tools/' }, { name: 'Cost per country' }]} />
  </div>

  <section class="section section--sm">
    <div class="container container--narrow">
      <span class="section-label">Cost per country</span>
      <h1 class="tool-title">What the same trip costs, country by country</h1>
      <p class="tool-intro">
        The same week costs roughly three times as much in Switzerland as in Bulgaria. If your
        route is flexible, that gap is the single biggest lever you have on the budget.
      </p>
      <div class="cpc-report">
        <span class="section-label">Full report</span>
        <h2 class="cpc-report__title">Priced for the way you actually travel</h2>
        <p class="cpc-report__intro">
          The free comparison below prices your whole trip with one index, the one for restaurants
          and hotels. That is the wrong basket for most people. Portugal sits well below the EU
          average for restaurants and hotels and slightly above it for food from shops, so somebody
          who cooks saves almost nothing there while somebody who eats out saves a quarter.
        </p>

        <div class="offer">
          <p class="offer__heading">What you get</p>
          <ul class="offer__list" role="list">
            {reportIncludes.map((item) => (
              <li class="offer__item">{item}</li>
            ))}
          </ul>
          <p class="offer__price">{REPORT_PRICE}</p>
          <a class="btn btn--primary cpc-report__cta" href={FULL_REPORT_URL}>{offerCta}</a>
          <p class="offer__terms">
            Payment is handled by Stripe on their own page. The report opens as soon as it goes
            through. No account needed.
          </p>
        </div>
      </div>

      <h2 class="cpc-cost-q">How much does a trip to Europe cost?</h2>
      <p class="cpc-cue">
        <a class="cpc-cue__link" href="#cpc-compare">Rather skip the questions? The free comparison
        below ranks all 28 countries straight away.</a>
      </p>
    </div>
  </section>

  <section class="section section--sm" id="cpc-compare">
    <div class="container container--narrow">
      <form class="cpc-controls" id="cpc-form" novalidate>
        <div class="field field--full">
          <span class="field__label">How you travel</span>
          <div class="style-picker" role="group" aria-label="Travel style presets">
            {styles.map(s => (
              <button type="button" class="style-btn" data-style={s.id} data-typical={s.typical}>
                <span class="style-btn__label">{s.label}</span>
                <span class="style-btn__range">{s.low}–{s.high === 380 ? '380+' : s.high}/day</span>
              </button>
            ))}
          </div>
          <p class="cpc-provenance">
            Daily figures are our own estimate for a Western European trip, then scaled to each
            country using Eurostat's price level index for restaurants and hotels, reference year
            {' '}{source.referenceYear}, where the EU27 average is 100.
          </p>
        </div>

        <label class="field">
          <span class="field__label">for how many nights</span>
          <input type="number" id="cpc-nights" min="1" max="365" step="1" value="7" inputmode="numeric" />
        </label>

        <label class="field">
          <span class="field__label">Your daily budget, per person</span>
          <div class="field-inline">
            <select id="cpc-currency" aria-label="Currency">
              <option value="€" selected>€</option>
              <option value="$">$</option>
              <option value="£">£</option>
              <option value="₱">₱</option>
              <option value="R$">R$</option>
            </select>
            <input type="number" id="cpc-budget" min="0" step="5" placeholder="optional" inputmode="decimal" />
          </div>
          <span class="field__hint">Optional. It draws a line across the comparison rather than
          changing any figure: countries at or below it are marked.</span>
        </label>
      </form>

      <div class="cpc-head">
        <h2 class="cpc-head__title">Can you afford Europe?</h2>
        <div class="cpc-head__row">
          <p class="cpc-head__lede">
            Pick how you travel and see what a week costs in all 28 countries, cheapest first.
          </p>
          <p class="cpc-head__meta" id="cpc-summary">—</p>
        </div>
      </div>

      <ol class="cpc-list" id="cpc-list" role="list">
        {countries.map(c => (
          <li class="cpc-row" data-pli={c.pli} data-name={c.name}>
            <div class="cpc-row__main">
              <span class="cpc-row__name">{c.name}</span>
              <span class="cpc-row__index">index {c.pli}</span>
            </div>
            <div class="cpc-row__bar"><span class="cpc-row__fill"></span></div>
            <div class="cpc-row__figures">
              <span class="cpc-row__day"></span>
              <span class="cpc-row__trip"></span>
            </div>
          </li>
        ))}
      </ol>
      <p class="cpc-legend" id="cpc-legend" hidden></p>
    </div>
  </section>

  <section class="section section--sm">
    <div class="container container--narrow">
      <div class="cpc-notes">
        <h2 class="cpc-notes__title">Where these numbers come from, and what they are not</h2>
        <p>
          The comparison above does one piece of arithmetic: it takes a daily figure and scales it
          by each country's published price level index, where the EU27 average is 100. The indices
          are <strong>{source.publisher}</strong>'s, for
          <strong>{source.category.replace('A0111, ', '')}</strong>, reference year
          <strong>{source.referenceYear}</strong>. The daily figure being scaled is ours: an
          editorial estimate for a Western European trip, the same band the
          {' '}<a href="/tools/budget/">budget calculator</a> uses. There is no survey behind it.
        </p>
        <p class="cpc-notes__limits">
          <strong>What it cannot tell you.</strong> This is the price level for restaurants and
          hotels only, not a full tourist basket. Capital cities and tourist districts run above
          their national average, sometimes well above. High season and low season can differ more
          than two countries do. Flights are not included, and they often decide the total. Treat
          the ranking as reliable and the exact figures as a starting point.
        </p>
        <p class="cpc-notes__src">
          Source: {source.publisher}, dataset <code>{source.dataset}</code>, indicator
          {' '}<code>{source.indicator}</code>. Eurostat last updated this
          {' '}{source.eurostatLastUpdated}; retrieved {source.retrieved}. The seven category
          indices behind the full report come from the same dataset and release, retrieved
          {' '}{source.categoriesRetrieved}.
          {' '}<a href={source.url} rel="nofollow noopener" target="_blank">View the dataset on Eurostat →</a>
          {' '}<a href="/sources/">See all sources and how often they are checked →</a>
        </p>
        <p class="cpc-notes__src">{source.note}</p>
      </div>

      <p class="visa-disclaimer">
        Estimates only. Prices vary by city, season and how far ahead you book. Educational
        information only. Not legal advice. Always check the official embassy or consulate source
        for visa fees.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* This page carries three stacked sections and the shared --space-12 block
     padding on each was most of its height. Scoped here, not in global.css. */
  .section--sm { padding-block: var(--space-8); }
  .section--sm + .section--sm { padding-top: 0; }

  .tool-title {
    font-family: var(--font-serif);
    font-weight: 700;
    margin: var(--space-2) 0 var(--space-3);
  }
  .tool-intro {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
    max-width: 60ch;
  }
  .tool-intro--muted { font-size: var(--text-base); margin-top: var(--space-3); }

  .cpc-controls {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3) var(--space-4);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-alt);
  }
  .field { display: block; margin: 0; }
  .field--full { grid-column: 1 / -1; }
  .field__label {
    display: block;
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    margin-bottom: var(--space-2);
    color: var(--color-text);
  }
  .field__hint {
    display: block;
    font-size: var(--text-xs);
    line-height: var(--leading-relaxed);
    color: var(--color-text-light);
    margin-top: var(--space-2);
  }
  .cpc-controls input,
  .cpc-controls select {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    font-size: var(--text-base);
    color: var(--color-text);
  }
  .cpc-controls input:focus,
  .cpc-controls select:focus { outline: none; border-color: var(--color-primary); }

  /* Must come after the shared rule above: same specificity, so source order
     decides. Without this the currency select takes the full width and
     collapses the amount field next to it. */
  .field-inline { display: flex; gap: var(--space-2); align-items: stretch; }
  .cpc-controls .field-inline select { width: 4.75rem; flex: 0 0 auto; padding-inline: 8px; }
  .cpc-controls .field-inline input { flex: 1 1 auto; width: auto; min-width: 0; }

  .style-picker { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-2); }
  .style-btn {
    display: flex; flex-direction: column; gap: 2px;
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    cursor: pointer;
    text-align: left;
    transition: border-color var(--transition-fast), background var(--transition-fast);
  }
  .style-btn:hover { border-color: var(--color-primary); }
  .style-btn.is-active { border-color: var(--color-primary); background: var(--color-primary-bg); }
  .style-btn__label { font-size: var(--text-sm); font-weight: var(--font-semibold); color: var(--color-navy); }
  .style-btn__range { font-size: var(--text-xs); color: var(--color-text-light); }

  .cpc-provenance {
    font-size: var(--text-xs);
    line-height: var(--leading-relaxed);
    color: var(--color-text-light);
    margin-top: var(--space-3);
    max-width: 62ch;
  }

  .cpc-head { margin-bottom: var(--space-4); }
  .cpc-head__title { font-family: var(--font-serif); font-size: var(--text-2xl); color: var(--color-navy); }
  .cpc-head__row {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: var(--space-2) var(--space-4); flex-wrap: wrap; margin-top: var(--space-2);
  }
  .cpc-head__lede { font-size: var(--text-sm); color: var(--color-text-muted); max-width: 52ch; }
  .cpc-head__meta { font-size: var(--text-sm); color: var(--color-text-muted); }

  .cpc-list { display: flex; flex-direction: column; gap: 2px; }
  .cpc-row {
    display: grid;
    grid-template-columns: minmax(9rem, 1.1fr) minmax(0, 1.6fr) minmax(7rem, auto);
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    border-left: 3px solid transparent;
    transition: background var(--transition-fast);
  }
  .cpc-row:nth-child(odd) { background: var(--color-bg-alt); }
  .cpc-row:hover { background: var(--color-primary-bg); }
  /* After the striping rule on purpose: the budget line has to win. */
  .cpc-row.is-under,
  .cpc-row.is-under:nth-child(odd) {
    background: var(--color-primary-bg);
    border-left-color: var(--color-primary);
  }
  .cpc-row.is-over .cpc-row__fill { opacity: 0.4; }

  .cpc-row__main { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
  .cpc-row__name { font-weight: var(--font-semibold); color: var(--color-navy); }
  .cpc-row__index { font-size: var(--text-xs); color: var(--color-text-light); }

  .cpc-row__bar {
    height: 8px; border-radius: var(--radius-full);
    background: rgba(27, 58, 92, 0.09); overflow: hidden;
  }
  .cpc-row__fill {
    display: block; height: 100%; width: 0;
    background: linear-gradient(90deg, var(--color-primary), var(--color-accent));
    border-radius: var(--radius-full);
    transition: width var(--transition-normal);
  }

  .cpc-row__figures { display: flex; flex-direction: column; align-items: flex-end; gap: 1px; }
  .cpc-row__day { font-weight: var(--font-semibold); color: var(--color-text); }
  .cpc-row__trip { font-size: var(--text-xs); color: var(--color-text-light); }

  /* Two columns on a wide screen, so 28 rows take 14 rows of height. CSS
     columns fill the first column top to bottom before starting the second,
     which is the order the rows are sorted in. This is why the sort moves the
     DOM nodes: CSS order has no effect inside a multi column layout. */
  @media (min-width: 900px) {
    .cpc-list {
      display: block;
      column-count: 2;
      column-gap: var(--space-5);
    }
    .cpc-row {
      break-inside: avoid;
      margin-bottom: 2px;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        "main day"
        "bar  trip";
      align-items: center;
      gap: 2px var(--space-3);
    }
    /* Name beside index, and the two figures beside the bar, rather than each
       pair stacking. Halves the height of every row. */
    .cpc-row__main {
      grid-area: main;
      flex-direction: row;
      align-items: baseline;
      gap: var(--space-2);
    }
    .cpc-row__bar { grid-area: bar; }
    .cpc-row__figures { display: contents; }
    .cpc-row__day  { grid-area: day;  text-align: right; }
    .cpc-row__trip { grid-area: trip; text-align: right; }
  }

  .cpc-legend {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-top: var(--space-4);
    padding-left: var(--space-3);
    border-left: 3px solid var(--color-primary);
  }

  /* The offer, as a plain block. The questions and the payment live on the
     full report page, so there is no disclosure and no script here. */
  .cpc-report {
    margin-top: var(--space-5);
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-alt);
  }
  .cpc-report__title {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    color: var(--color-navy);
    margin: var(--space-1) 0 var(--space-3);
  }
  .cpc-report__intro {
    display: block;
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
    max-width: 62ch;
    margin-bottom: 0;
  }


  .cpc-report__cta { white-space: normal; }

  /* The offer, said plainly before anybody is asked to pay. */
  .offer {
    display: block;
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }
  .offer__heading {
    display: block;
    font-size: var(--text-xs);
    letter-spacing: .1em;
    text-transform: uppercase;
    font-weight: var(--font-semibold);
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }
  .offer__list { list-style: none; padding: 0; margin: 0 0 var(--space-4); }
  .offer__item {
    display: block;
    position: relative;
    padding-left: var(--space-5);
    margin-bottom: var(--space-2);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
    max-width: 58ch;
  }
  .offer__item::before {
    content: '';
    position: absolute;
    left: 2px;
    top: .55em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent);
  }
  .offer__price {
    display: block;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--text-4xl, 2.25rem);
    line-height: 1.1;
    color: var(--color-navy);
    margin-bottom: var(--space-3);
  }
  .offer__terms {
    display: block;
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    line-height: var(--leading-relaxed);
    color: var(--color-text-light);
    max-width: 52ch;
  }

  /* A heading phrased the way people search, and one line into the comparison. */
  .cpc-cost-q {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    color: var(--color-navy);
    margin: var(--space-6) 0 var(--space-2);
  }
  .cpc-cue {
    margin-top: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    max-width: 62ch;
    color: var(--color-text-muted);
  }
  .cpc-cue__link {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 3px;
  }
  .cpc-cue__link:hover {
    color: var(--color-accent);
    text-decoration-color: var(--color-accent);
  }


  .cpc-notes {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-5);
    margin-top: 0;
  }
  .cpc-notes__title {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    color: var(--color-navy);
    margin-bottom: var(--space-3);
  }
  .cpc-notes p {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }
  .cpc-notes a { color: var(--color-accent-dark); }
  .cpc-notes__limits {
    background: var(--color-bg-alt);
    border-left: 3px solid var(--color-accent);
    padding: var(--space-4);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }
  .cpc-notes__src { font-size: var(--text-xs) !important; color: var(--color-text-light) !important; }
  .cpc-notes code { font-size: 0.9em; background: var(--color-bg-alt); padding: 1px 5px; border-radius: 4px; }

  .visa-disclaimer {
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
    text-align: center;
    margin-top: var(--space-6);
  }

  @media (max-width: 720px) {
    .cpc-controls { grid-template-columns: 1fr; }
    .cpc-row { grid-template-columns: 1fr auto; gap: var(--space-2) var(--space-3); }
    .cpc-row__bar { grid-column: 1 / -1; order: 3; }
  }
</style>

<script>
  /* ───────────────────────── the free comparison ───────────────────────── */
  //
  // The reference is permanently the EU average, which the dataset puts at 100.
  // There is nothing to pick, so nothing a visitor touches can rescale the
  // other countries. perDay = base × countryIndex ÷ 100, where base is the
  // editorial daily figure behind the chosen style.
  //
  // The budget input does not appear in that arithmetic anywhere. It draws a
  // line: countries at or below it are marked, countries above it are not.

  const STORAGE_KEY = 'durian-cpc-v1';
  const DEFAULT_STYLE = 'mid';

  const nightsEl = document.getElementById('cpc-nights') as HTMLInputElement | null;
  const budgetEl = document.getElementById('cpc-budget') as HTMLInputElement | null;
  const currencyEl = document.getElementById('cpc-currency') as HTMLSelectElement | null;
  const listEl = document.getElementById('cpc-list');
  const summaryEl = document.getElementById('cpc-summary');
  const legendEl = document.getElementById('cpc-legend') as HTMLElement | null;
  // Scoped to this page's own controls and list, not the document. The same
  // defect ran the other way too: a bare '.style-btn' here attached this
  // page's click handlers to the budget planner's buttons.
  const controlsEl = document.getElementById('cpc-form');
  const styleBtns = Array.from(controlsEl?.querySelectorAll<HTMLButtonElement>('.style-btn') ?? []);
  const rows = Array.from(listEl?.querySelectorAll<HTMLLIElement>('.cpc-row') ?? []);

  function activeStyle(): HTMLButtonElement | undefined {
    return styleBtns.find(b => b.classList.contains('is-active'));
  }

  function selectStyle(id: string) {
    const wanted = styleBtns.find(b => b.dataset.style === id)
      ?? styleBtns.find(b => b.dataset.style === DEFAULT_STYLE)
      ?? styleBtns[0];
    styleBtns.forEach(b => b.classList.toggle('is-active', b === wanted));
  }

  function money(v: number): string {
    return (currencyEl?.value ?? '') + Math.round(v).toLocaleString('en-GB');
  }

  function update() {
    const base = parseFloat(activeStyle()?.dataset.typical ?? '0') || 0;
    const nights = Math.max(1, Math.round(parseFloat(nightsEl?.value ?? '1') || 1));
    const rawBudget = parseFloat(budgetEl?.value ?? '');
    const budget = Number.isFinite(rawBudget) && rawBudget > 0 ? rawBudget : 0;

    const computed = rows.map(row => {
      const pli = parseFloat(row.dataset.pli ?? '100');
      const perDay = (base * pli) / 100;
      return { row, pli, perDay, trip: perDay * nights };
    });

    const maxDay = Math.max(...computed.map(c => c.perDay), 0);

    // The rows are reordered as DOM nodes rather than by CSS order, because the
    // two column layout uses CSS columns, where order does nothing at all.
    // Moving them through a fragment keeps it to one reflow.
    if (listEl) {
      const inOrder = document.createDocumentFragment();
      computed
        .slice()
        .sort((a, b) => a.perDay - b.perDay)
        .forEach(({ row }) => inOrder.appendChild(row));
      listEl.appendChild(inOrder);
    }

    let under = 0;
    computed.forEach(({ row, perDay, trip }) => {
      const dayEl = row.querySelector('.cpc-row__day');
      const tripEl = row.querySelector('.cpc-row__trip');
      const fill = row.querySelector('.cpc-row__fill') as HTMLElement | null;
      if (dayEl) dayEl.textContent = money(perDay) + ' / day';
      if (tripEl) tripEl.textContent = money(trip) + ' for ' + nights + (nights === 1 ? ' night' : ' nights');
      if (fill) fill.style.width = maxDay > 0 ? (perDay / maxDay) * 100 + '%' : '0%';

      const isUnder = budget > 0 && perDay <= budget;
      if (isUnder) under++;
      row.classList.toggle('is-under', isUnder);
      row.classList.toggle('is-over', budget > 0 && !isUnder);
    });

    if (summaryEl) {
      const sorted = computed.slice().sort((a, b) => a.perDay - b.perDay);
      const low = sorted[0];
      const high = sorted[sorted.length - 1];
      const ratio = low.perDay > 0 ? high.perDay / low.perDay : 0;
      summaryEl.textContent =
        high.row.dataset.name + ' costs about ' + ratio.toFixed(1) + '× ' + low.row.dataset.name +
        ' for the same trip.';
    }

    if (legendEl) {
      if (budget > 0) {
        legendEl.hidden = false;
        legendEl.textContent = under === 0
          ? 'None of the 28 countries come in at or under ' + money(budget) + ' a day on this style of trip.'
          : under + ' of 28 ' + (under === 1 ? 'country comes' : 'countries come') +
            ' in at or under ' + money(budget) + ' a day. Those rows are marked.';
      } else {
        legendEl.hidden = true;
        legendEl.textContent = '';
      }
    }

    save();
  }

  function save() {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify({
        style: activeStyle()?.dataset.style ?? DEFAULT_STYLE,
        nights: nightsEl?.value,
        budget: budgetEl?.value,
        currency: currencyEl?.value,
      }));
    } catch (e) { /* private mode */ }
  }

  // A state saved by the old version carried an `amount` and a `reference`.
  // Neither exists now. Every key is read by name and anything unrecognised is
  // ignored, so an old state restores the parts that still mean something and
  // falls back to Mid-range for the rest.
  function restore() {
    selectStyle(DEFAULT_STYLE);
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return;
      const d = JSON.parse(raw);
      if (!d || typeof d !== 'object') return;
      if (typeof d.style === 'string') selectStyle(d.style);
      if (nightsEl && typeof d.nights === 'string' && d.nights) nightsEl.value = d.nights;
      if (budgetEl && typeof d.budget === 'string') budgetEl.value = d.budget;
      if (currencyEl && typeof d.currency === 'string') {
        const ok = Array.from(currencyEl.options).some(o => o.value === d.currency);
        if (ok) currencyEl.value = d.currency;
      }
    } catch (e) { /* ignore */ }
  }

  // This script is bundled alongside the other tool pages and runs on them as
  // well. Without this check, update() saved {style: 'mid'} over the visitor's
  // saved choice on every tool page they opened, dropping their nights, budget
  // and currency, and the full report page then priced them at the wrong
  // style. It now does nothing unless its own list and controls are present.
  if (listEl && controlsEl) {
    styleBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        styleBtns.forEach(b => b.classList.toggle('is-active', b === btn));
        update();
      });
    });

    controlsEl.addEventListener('input', update);
    controlsEl.addEventListener('change', update);

    restore();
    update();
  }

</script>
