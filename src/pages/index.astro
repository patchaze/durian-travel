<script is:inline>
  // Count the trust-strip numbers up from zero on first view. Purely visual:
  // the real values are server-rendered, so crawlers and no-JS visitors see
  // them untouched. Skipped entirely under reduced motion.
  (function () {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var els = document.querySelectorAll('.trust-strip__value');
    els.forEach(function (el) {
      var target = parseInt(el.textContent, 10);
      if (isNaN(target)) return;
      var start = null, dur = 900;
      el.textContent = '0';
      function step(ts) {
        if (!start) start = ts;
        var p = Math.min((ts - start) / dur, 1);
        el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
        if (p < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    });
  })();
</script>
