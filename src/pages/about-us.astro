---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import CTABanner from '../components/CTABanner.astro';

// Authorship is the organisation, never a person. This page says plainly that
// Durian Travel is one person writing as an organisation, and names nobody.
const aboutSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "DURIAN Travel",
  "url": "https://www.duriantravel.com",
  "description": "DURIAN Travel publishes free guides and planning tools, and one paid cost report, for people planning a trip to Europe from outside it.",
  "areaServed": "Worldwide",
  "knowsAbout": [
    "Schengen short stay visa rules",
    "Travel costs across European countries",
    "Planning a trip to Europe from outside the continent"
  ],
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "Customer Support",
    "url": "https://www.duriantravel.com/contact/"
  }
};

const whoWeAre = [
  'A one person project based in Europe, writing as Durian Travel',
  'A publisher of free guides and planning tools for trips to Europe',
  'A source that says where its figures come from',
];

const whoWeAreNot = [
  'A travel agency. We do not book flights or hotels',
  'A visa agency. We do not submit applications or promise any result',
  'A law firm. Nothing here is legal advice',
  'A service that reviews documents or runs calls',
];
---

<BaseLayout
  title="About DURIAN Travel | Free Guides and Planners for a Trip to Europe"
  description="Durian Travel is a one person project based in Europe. We publish free guides and planning tools for people planning a trip to Europe from outside it."
  canonical="https://www.duriantravel.com/about-us/"
  breadcrumb={[{ name: 'About', url: 'https://www.duriantravel.com/about-us/' }]}
  schema={aboutSchema}
  keywords="about DURIAN Travel, planning a trip to Europe from outside Europe, free Europe travel planners"
>
  <div class="container">
    <Breadcrumb items={[{ name: 'About DURIAN Travel' }]} />
  </div>

  <section class="hero-sm hero-gradient">
    <div class="container container--narrow">
      <span class="section-label" style="color:var(--color-accent-light)">About</span>
      <h1 class="hero-sm__title" style="color:white">About DURIAN Travel</h1>
      <p class="hero-sm__subtitle">
        Durian Travel is a one person project based in Europe. We publish free guides and planning
        tools for people who live outside Europe and want to plan a trip there. Everything is free to
        use, except one paid report on what your trip would cost in each country you are considering.
        We do not book travel, submit visa applications, review documents or run calls.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow prose">
      <h2>What Durian Travel does</h2>
      <p>
        Most travel writing about Europe assumes you can cross a border without a second thought. If
        you live outside Europe, the trip looks different. A visa may come before anything else, the
        long flight shapes the budget, and prices change more from one country to the next than most
        guides admit.
      </p>
      <p>
        So we write for that reader. The <a href="/blog/">blog</a> and the
        {' '}<a href="/destinations/">destination guides</a> explain how things actually work, and the
        {' '}<a href="/tools/">planners</a> let you check the numbers yourself: whether your passport
        needs a visa, what the same trip costs in each country, and what your own budget adds up to.
      </p>
      <p>
        Behind the site is one person who has traveled widely inside Europe and writes as Durian
        Travel. There is no team of advisors and no agency.
      </p>

      <h2>Who we work with</h2>
      <p>
        Our readers come from every region outside Europe. Some are planning a first trip and want to
        understand the rules before they book anything. Others are comparing several countries and
        want to see what each one really costs before they choose.
      </p>
      <p>
        What they share is that they are coming to Europe from the outside, and they want information
        written for that.
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <header class="section-header text-center">
        <span class="section-label">Plainly</span>
        <h2 class="section-title">What we are and what we are not</h2>
      </header>
      <div class="truth-grid">
        <div class="truth-card">
          <h3>We are</h3>
          <ul class="check-list">
            {whoWeAre.map(item => <li>{item}</li>)}
          </ul>
        </div>
        <div class="truth-card">
          <h3>We are not</h3>
          <ul class="x-list">
            {whoWeAreNot.map(item => <li>{item}</li>)}
          </ul>
        </div>
      </div>
      <div class="container--narrow prose" style="margin-top:var(--space-8)">
        <p>
          If your situation involves an earlier refusal, an overstay, or anything else that needs legal
          representation, speak to a qualified immigration lawyer. Nothing on this site replaces one.
        </p>
      </div>
    </div>
  </section>

  <CTABanner />
</BaseLayout>

<style>
.hero-sm { padding-block: var(--space-16); }
.hero-sm__title {
  font-family: var(--font-serif);
  font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
  margin-bottom: var(--space-4);
}
.hero-sm__subtitle {
  font-size: var(--text-lg);
  color: hsla(0, 0%, 100%, 0.85);
  max-width: 60ch;
  line-height: var(--leading-relaxed);
}
.truth-grid {
  display: grid;
  gap: var(--space-6);
  grid-template-columns: repeat(2, minmax(0, 1fr));
}
.truth-card {
  background: white;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: var(--space-8);
}
/* Colour-coded top edges so the two columns read at a glance */
.truth-card:first-child { border-top: 3px solid var(--color-success); }
.truth-card:last-child { border-top: 3px solid var(--color-accent); }
.check-list li,
.x-list li {
  position: relative;
  padding-left: var(--space-8);
  margin-bottom: var(--space-3);
  line-height: var(--leading-relaxed);
  color: var(--color-text-muted);
}
.check-list li::before,
.x-list li::before {
  position: absolute;
  left: 0;
  top: 1px;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  font-size: 0.7rem;
  font-weight: var(--font-bold);
  display: flex;
  align-items: center;
  justify-content: center;
}
.check-list li::before {
  content: "\2713";
  color: var(--color-success);
  background: rgba(45, 143, 92, 0.12);
}
.x-list li::before {
  content: "\2715";
  color: var(--color-accent-dark);
  background: var(--color-accent-bg);
}
.truth-card h3 {
  margin-bottom: var(--space-4);
}
@media (max-width: 900px) {
  .truth-grid {
    grid-template-columns: 1fr;
  }
}
</style>
