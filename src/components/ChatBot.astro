---
// The avatar is an inline SVG rather than an image: it is a sibling of the
// logo mark in Header.astro, stays legible at 40px, and costs no bytes.

// Suggested questions are rendered here rather than created in the client
// script. Astro scopes component styles by appending [data-astro-cid-*] to the
// selector, and elements built with document.createElement() never carry that
// attribute — so JS-created buttons silently received none of the styling below
// and fell back to the browser default. Rendering them in the template fixes
// that, and means they exist before the script runs.
//
// `id` must match an entry in TOPICS in the script below.
const quickReplies = [
  { id: 'itinerary', label: 'Help me plan a route' },
  { id: 'budget', label: 'What will it cost?' },
  { id: 'countries', label: 'Where should I go?' },
  { id: 'human', label: 'Talk to a person' },
];
---

<div id="chatbot-container" class="chatbot-container">
  <!-- Chat Toggle Button -->
  <button id="chatbot-toggle" class="chatbot-toggle" aria-label="Open chat">
    <div class="toggle-icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 21 1.9-5.7a8.5 8.5 0 1 1 3.8 3.8z"/></svg>
    </div>
    <span class="pulse"></span>
  </button>

  <!-- Chat Window -->
  <div id="chatbot-window" class="chatbot-window hidden">
    <div class="chatbot-header">
      <div class="chatbot-info">
        <div class="avatar-container">
          <svg class="avatar-mark" width="40" height="40" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Durian Travel assistant">
            <circle cx="20" cy="20" r="20" fill="#C44B36"/>
            <text x="20" y="28" text-anchor="middle" font-family="'Playfair Display',Georgia,serif" font-size="22" fill="#FFFFFF">D</text>
          </svg>
          <span class="status-indicator"></span>
        </div>
        <div>
          <h3 class="chatbot-name">Durian Assistant</h3>
          <p class="chatbot-status">Answers from our published guides</p>
        </div>
      </div>
      <button id="chatbot-close" class="close-btn" aria-label="Close chat">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>

    <div id="chatbot-messages" class="chatbot-messages">
      <div class="message ai">
        <div class="message-content">
          Hello. Ask me about planning your trip — routes, budgets, where to go — or about Schengen visas. Pick a question below or type your own.
        </div>
        <span class="message-time">Just now</span>
      </div>
    </div>

    <div id="typing-indicator" class="typing-indicator hidden">
      <span></span>
      <span></span>
      <span></span>
    </div>

    <div id="chatbot-quick" class="chatbot-quick" role="group" aria-label="Suggested questions">
      {quickReplies.map(q => (
        <button type="button" class="quick-pill" data-topic={q.id}>{q.label}</button>
      ))}
    </div>

    <form id="chatbot-form" class="chatbot-input-area">
      <input
        type="text"
        id="chatbot-input"
        placeholder="Ask about visas, documents, budget..."
        autocomplete="off"
        required
      />
      <button type="submit" id="chatbot-send" aria-label="Send message">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
      </button>
    </form>

    <p class="chatbot-disclaimer">
      Educational information only. Not legal advice. Always check the official embassy or consulate source.
    </p>
  </div>
</div>

<style>
  .chatbot-container { position: fixed; bottom: 24px; right: 24px; z-index: 1000; font-family: var(--font-sans, system-ui, sans-serif); }
  .chatbot-toggle { width: 60px; height: 60px; border-radius: 50%; background: var(--color-navy, #0F2138); color: white; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; position: relative; box-shadow: 0 8px 24px rgba(0,0,0,0.2); transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1); }
  .chatbot-toggle:hover { transform: scale(1.1) translateY(-4px); }
  .pulse { position: absolute; inset: 0; border-radius: 50%; background: var(--color-navy, #0F2138); opacity: 0.6; z-index: -1; animation: pulse 2s infinite; }
  @keyframes pulse { 0% { transform: scale(1); opacity: 0.6; } 100% { transform: scale(1.5); opacity: 0; } }

  .chatbot-window { position: absolute; bottom: 80px; right: 0; width: 380px; height: 560px; background: var(--color-bg-alt, #F4F6F8); border-radius: 20px; box-shadow: 0 24px 60px rgba(15, 33, 56, 0.22); display: flex; flex-direction: column; overflow: hidden; transform-origin: bottom right; transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.3s ease; border: 1px solid rgba(15, 33, 56, 0.08); }
  .chatbot-window.hidden { opacity: 0; transform: scale(0.8) translateY(20px); pointer-events: none; }

  .chatbot-header { padding: 16px 18px; background: var(--color-navy, #0F2138); color: white; display: flex; align-items: center; justify-content: space-between; }
  .chatbot-info { display: flex; align-items: center; gap: 12px; }
  .avatar-container { width: 40px; height: 40px; border-radius: 50%; position: relative; flex-shrink: 0; }
  .avatar-mark { width: 100%; height: 100%; display: block; border-radius: 50%; }
  .status-indicator { position: absolute; bottom: 0; right: 0; width: 10px; height: 10px; background: #4ade80; border: 2px solid var(--color-navy, #0F2138); border-radius: 50%; }
  .chatbot-name { margin: 0; font-size: 1rem; }
  .chatbot-status { margin: 0; font-size: 0.75rem; opacity: 0.8; }
  .close-btn { background: none; border: none; color: white; cursor: pointer; padding: 4px; display: flex; align-items: center; justify-content: center; border-radius: 6px; transition: background 0.2s; }
  .close-btn:hover { background: rgba(255,255,255,0.15); }

  .chatbot-messages { flex: 1; overflow-y: auto; padding: 18px; display: flex; flex-direction: column; gap: 14px; }
  .message { max-width: 88%; display: flex; flex-direction: column; gap: 3px; animation: slideUp 0.3s ease forwards; }
  @keyframes slideUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
  .message.ai { align-self: flex-start; }
  .message.user { align-self: flex-end; }
  .message-content { padding: 11px 14px; border-radius: 14px; font-size: 0.875rem; line-height: 1.55; white-space: pre-wrap; }
  .message.ai .message-content { background: #FFFFFF; color: var(--color-text, #1A1A2E); border-bottom-left-radius: 4px; box-shadow: 0 1px 2px rgba(15, 33, 56, 0.06); }
  .message.ai .message-content a { color: var(--color-accent-dark, #A33D2B); text-decoration: none; font-weight: 600; border-bottom: 1px solid rgba(196, 75, 54, 0.35); transition: color 0.2s, border-color 0.2s; }
  .message.ai .message-content a:hover { color: var(--color-accent, #C44B36); border-bottom-color: var(--color-accent, #C44B36); }
  .message.ai .message-content strong { color: var(--color-navy, #0F2138); }
  .message.user .message-content { background: var(--color-primary, #1B3A5C); color: white; border-bottom-right-radius: 4px; }
  .message-time { font-size: 0.66rem; color: var(--color-text-light, #8892A0); padding: 0 4px; }
  .message.user .message-time { text-align: right; }

  .typing-indicator { padding: 12px 20px; display: flex; gap: 4px; align-items: center; }
  .typing-indicator span { width: 6px; height: 6px; background: #aaa; border-radius: 50%; animation: bounce 1.4s infinite ease-in-out both; }
  .typing-indicator span:nth-child(2) { animation-delay: 0.16s; }
  .typing-indicator span:nth-child(3) { animation-delay: 0.32s; }
  @keyframes bounce { 0%, 80%, 100% { transform: scale(0); } 40% { transform: scale(1); } }

  .chatbot-input-area { padding: 12px 14px; background: #FFFFFF; border-top: 1px solid var(--color-border-light, #EFF1F4); display: flex; gap: 10px; }
  .chatbot-input-area input { flex: 1; border: 1px solid var(--color-border, #E2E6EB); background: var(--color-bg-alt, #F4F6F8); padding: 10px 12px; border-radius: 10px; outline: none; font-size: 0.85rem; color: var(--color-text, #1A1A2E); transition: border-color 0.15s, background 0.15s; }
  .chatbot-input-area input::placeholder { color: var(--color-text-light, #8892A0); }
  .chatbot-input-area input:focus { background: #FFFFFF; border-color: var(--color-primary, #1B3A5C); }
  .chatbot-input-area button { background: var(--color-primary, #1B3A5C); color: white; border: none; width: 38px; height: 38px; border-radius: 10px; cursor: pointer; display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: background 0.2s, opacity 0.2s; }
  .chatbot-input-area button:hover:not(:disabled) { background: var(--color-navy, #0F2138); }
  .chatbot-input-area button:disabled { opacity: 0.45; cursor: not-allowed; }

  .chatbot-quick { display: flex; flex-wrap: wrap; gap: 6px; padding: 2px 14px 12px; background: var(--color-bg-alt, #F4F6F8); }
  .quick-pill {
    background: rgba(27, 58, 92, 0.9);
    backdrop-filter: blur(10px) saturate(140%);
    -webkit-backdrop-filter: blur(10px) saturate(140%);
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 1px 3px rgba(15, 33, 56, 0.18), inset 0 1px 0 rgba(255, 255, 255, 0.12);
    color: #FFFFFF;
    font: inherit;
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.25;
    padding: 7px 13px;
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
  }
  .quick-pill:hover {
    background: rgba(15, 33, 56, 0.97);
    transform: translateY(-1px);
    box-shadow: 0 3px 8px rgba(15, 33, 56, 0.26), inset 0 1px 0 rgba(255, 255, 255, 0.16);
  }
  .quick-pill:active { transform: translateY(0); }
  .quick-pill:focus-visible { outline: 2px solid var(--color-accent, #C44B36); outline-offset: 2px; }

  .chatbot-disclaimer {
    margin: 0; padding: 0 14px 12px; background: #FFFFFF;
    font-size: 0.66rem; line-height: 1.45; color: var(--color-text-light, #8892A0); text-align: center;
  }

  .hidden { display: none !important; }

  @media (max-width: 480px) {
    .chatbot-window { width: calc(100vw - 32px); right: -8px; height: 70vh; }
  }
</style>

<script>
  // ---------------------------------------------------------------------------
  // Curated assistant — no model, no API key, no network calls.
  //
  // Every answer below is drawn from copy already published on this site
  // (mostly /faq/ and the guides). That is deliberate: the widget cannot invent
  // a rule, a fee, or an outcome, because it can only repeat vetted wording.
  // When nothing matches it says so and points to a human, rather than guessing.
  //
  // Adding a topic: add an entry to TOPICS. `keywords` are matched as
  // lowercase substrings against the visitor's message. Put the more specific
  // topics first — ties are broken by array order.
  //
  // Deliberately NOT answered here: anything that states a fee, a processing
  // time, or a border-rule date. Those go stale. Link to the guide instead, so
  // there is one place to keep current.
  // ---------------------------------------------------------------------------

  type Topic = {
    id: string;
    label?: string;
    keywords: string[];
    answer: string;
  };

  const TOPICS: Topic[] = [
    {
      id: 'guarantee',
      label: 'Can you guarantee approval?',
      keywords: ['guarantee', 'guaranteed', 'approval rate', 'approved', 'will i get', 'chances', 'odds', 'success rate', 'sure thing'],
      answer: "No, and no honest service can. Visa decisions are made by embassy and consulate officers based on their assessment of your application. We help you prepare the strongest possible application, but we have no influence over consular decisions.\n\nMore in the [FAQ](/faq/)."
    },
    {
      id: 'lawyer',
      label: 'Are you immigration lawyers?',
      keywords: ['lawyer', 'attorney', 'law firm', 'legal advice', 'solicitor', 'legally'],
      answer: "No. DURIAN is an educational visa application strategy consultancy. We do not provide legal advice, legal representation, or any service that constitutes the practice of immigration law. For legal advice, consult a qualified immigration attorney.\n\nSee the [FAQ](/faq/) and the [disclaimer](/disclaimer/)."
    },
    {
      id: 'submit',
      label: 'Do you submit my application?',
      keywords: ['submit', 'on my behalf', 'apply for me', 'lodge', 'file it for me', 'send my application'],
      answer: "No. We provide educational guidance on how to prepare your application. You submit it yourself to the relevant embassy or consulate.\n\nThat is the main way we differ from a visa agency: lower cost, more transparency, more control for you. More in the [FAQ](/faq/)."
    },
    {
      id: 'refusal',
      label: 'I was refused before',
      keywords: ['refused', 'refusal', 'rejected', 'rejection', 'denied', 'reapply', 'reapplication', 'appeal'],
      answer: "Yes, this is one of the areas we cover. We can help you decode your refusal letter and build a stronger application for resubmission.\n\nStart with [the most common refusal reasons](/blog/visa-refusal-reasons/), then [get in touch](/contact/) if you want it looked at properly."
    },
    {
      id: 'documents',
      label: 'What documents do I need?',
      keywords: ['document', 'documents', 'checklist', 'paperwork', 'what do i need', 'requirements', 'financial proof', 'bank statement', 'insurance', 'cover letter'],
      answer: "The core set is usually a valid passport, travel insurance, proof of accommodation, financial evidence, and a credible itinerary, but the exact list varies by consulate and nationality.\n\nWork through the [Schengen document checklist](/blog/schengen-document-checklist/) and the [full Schengen visa guide](/schengen-visa-guide/). For the cover letter specifically, there is [a walkthrough with templates](/blog/how-to-write-visa-cover-letter/)."
    },
    {
      id: 'selfemployed',
      label: "I'm self-employed",
      keywords: ['self-employed', 'self employed', 'freelance', 'freelancer', 'contractor', 'business owner', 'nomad', 'remote work'],
      answer: "Yes. Self-employed applicants often face particular challenges with financial proof. We help freelancers, contractors and business owners work out which documents to gather and how to present them.\n\nMore in the [FAQ](/faq/), or [get in touch](/contact/)."
    },
    {
      id: 'visa_cost',
      label: 'What does a visa cost?',
      keywords: ['visa fee', 'visa cost', 'how much is the visa', 'application fee', 'consulate fee', 'price of the visa'],
      answer: "Fees change, so rather than quote a number that might be out of date, here is the page kept current: [how much a Schengen visa costs](/blog/how-much-does-schengen-visa-cost/).\n\nAlways confirm the current fee on the official site of the embassy or visa centre handling your application."
    },
    {
      id: 'budget',
      label: 'How much will my trip cost?',
      keywords: ['budget', 'how much', 'daily cost', 'spending', 'afford', 'expensive', 'cheap', 'money'],
      answer: "Build the budget in euros first, separating fixed costs from daily spending. That is the part most people get wrong.\n\nPut your own numbers into the [free budget calculator](/tools/budget/) to get a total. The [Europe trip budget guide](/blog/europe-trip-budget/) explains the method behind it, and [train travel](/blog/train-travel-europe/) is usually where the savings are."
    },
    {
      id: 'ees_etias',
      label: 'What are EES and ETIAS?',
      keywords: ['ees', 'etias', 'entry exit', 'entry/exit', 'border system', 'biometric', 'new border'],
      answer: "Two different things, often confused.\n\n**EES** is the Entry/Exit System, which records short-stay entries and exits electronically. It has been fully operational across all Schengen countries since 10 April 2026.\n\n**ETIAS** is a travel authorisation for visa-exempt travellers only. If you need a Schengen visa, ETIAS does not apply to you. It is scheduled to start in the last quarter of 2026; the exact date has not been announced yet.\n\nDetail in the [requirements guide](/blog/schengen-visa-requirements-non-european-travelers/). Confirm current status on the official EU pages before you rely on it."
    },
    {
      id: 'timeline',
      label: 'When should I apply?',
      keywords: ['when should i apply', 'how early', 'timeline', 'how long does it take', 'processing time', 'months before', 'lead time', 'how soon'],
      answer: "There is a window: not too early, not too late, and it is tighter than most people expect once appointments are factored in.\n\nThe [trip planning timeline](/blog/europe-trip-planning-timeline/) lays out the order to do things in, and the [Schengen visa guide](/schengen-visa-guide/) covers current timings."
    },
    {
      id: 'itinerary',
      label: 'Help me plan a route',
      keywords: ['itinerary', 'route', 'plan my trip', 'multi-country', 'multi country', 'how many days', 'where should i go', 'sequence'],
      answer: "Route logic matters more than most people realise, both for the trip itself and for how coherent your application looks.\n\nStart with the [multi-country itinerary guide](/blog/multi-country-europe-itinerary/), or the [10-day Europe itinerary](/blog/10-day-europe-itinerary/) if you are short on time."
    },
    {
      id: 'countries',
      label: 'Where should I go?',
      keywords: ['which countries', 'destination', 'destinations', 'country guide', 'italy', 'france', 'spain', 'portugal', 'greece', 'germany', 'sweden', 'netherlands', 'switzerland', 'croatia'],
      answer: "There is a guide for each Schengen country, covering what to expect and how it fits into a wider route.\n\nBrowse them all on the [destinations page](/destinations/)."
    },
    {
      id: 'audit',
      label: 'What is the free audit?',
      keywords: ['free audit', 'readiness', 'free consultation', 'free call', 'audit'],
      answer: "A free 20-minute consultation where we review your current visa preparation strategy and identify the specific areas you need to strengthen before you submit.\n\nDetails on the [free visa audit page](/free-visa-audit/). It is not a guarantee of visa approval."
    },
    {
      id: 'human',
      label: 'I want to talk to a person',
      keywords: ['talk to', 'speak to', 'human', 'real person', 'contact', 'email', 'phone', 'book a call', 'consultation', 'someone'],
      answer: "Of course. Everything runs online via video call, and you can reach Patricia through the [contact page](/contact/)."
    },
    {
      id: 'language',
      keywords: ['language', 'portuguese', 'spanish', 'french', 'english', 'idioma'],
      answer: "Services are available in English, Portuguese, Spanish and French. Mention your preferred language when you book. More in the [FAQ](/faq/)."
    },
    {
      id: 'location',
      keywords: ['where are you', 'located', 'location', 'office', 'in person', 'online', 'video call'],
      answer: "All sessions are conducted online via video call, with clients worldwide. More in the [FAQ](/faq/)."
    },
    {
      id: 'visa_types',
      keywords: ['what visa', 'type c', 'tourist visa', 'uk visa', 'us visa', 'student visa', 'work visa', 'which visas'],
      answer: "The main focus is the Schengen tourist visa (Type C). Many of the same document principles apply to UK visitor visas and US tourist visas, but we will tell you plainly if your visa type is outside what we cover.\n\nMore in the [FAQ](/faq/)."
    }
  ];

  // The suggested-question buttons live in the template above, not here, so
  // that Astro's scoped styles apply to them. This script only wires them up.

  const FALLBACK =
    "I can only answer from what is published on this site, and I do not have anything on that.\n\n" +
    "Try the [blog](/blog/) or the [Schengen visa guide](/schengen-visa-guide/), or [ask Patricia directly](/contact/) — she will give you a straight answer.";

  const toggleBtn = document.getElementById('chatbot-toggle');
  const closeBtn = document.getElementById('chatbot-close');
  const chatWindow = document.getElementById('chatbot-window');
  const chatForm = document.getElementById('chatbot-form');
  const chatInput = document.getElementById('chatbot-input') as HTMLInputElement;
  const chatMessages = document.getElementById('chatbot-messages');
  const typingIndicator = document.getElementById('typing-indicator');
  const sendBtn = document.getElementById('chatbot-send') as HTMLButtonElement;
  const quickWrap = document.getElementById('chatbot-quick');

  let isProcessing = false;

  toggleBtn?.addEventListener('click', () => {
    chatWindow?.classList.toggle('hidden');
    if (!chatWindow?.classList.contains('hidden')) chatInput?.focus();
  });

  closeBtn?.addEventListener('click', () => chatWindow?.classList.add('hidden'));

  chatForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (isProcessing) return;
    const message = chatInput?.value.trim();
    if (!message) return;
    chatInput.value = '';
    ask(message);
  });

  // Buttons already exist in the DOM; each carries the topic id it should
  // answer, so a click resolves directly rather than going back through
  // keyword matching.
  function wireQuickReplies() {
    if (!quickWrap) return;
    quickWrap.querySelectorAll<HTMLButtonElement>('.quick-pill').forEach(btn => {
      btn.addEventListener('click', () => {
        const topic = TOPICS.find(t => t.id === btn.dataset.topic);
        ask(btn.textContent?.trim() ?? '', topic ?? null);
      });
    });
  }

  // Score each topic by how many of its keywords appear in the message.
  // Longer keyword matches count for more, so "visa fee" beats a stray "visa".
  function findTopic(message: string): Topic | null {
    const text = ' ' + message.toLowerCase().replace(/[^a-z0-9\s/-]/g, ' ') + ' ';
    let best: Topic | null = null;
    let bestScore = 0;
    for (const topic of TOPICS) {
      let score = 0;
      for (const kw of topic.keywords) {
        if (text.includes(kw.toLowerCase())) score += kw.length;
      }
      if (score > bestScore) {
        bestScore = score;
        best = topic;
      }
    }
    return bestScore > 0 ? best : null;
  }

  // `forced` is set when the visitor tapped a suggestion, so that answer is
  // certain rather than dependent on the label happening to match keywords.
  function ask(message: string, forced: Topic | null = null) {
    if (!message) return;
    isProcessing = true;
    if (sendBtn) sendBtn.disabled = true;

    addMessage(message, 'user');
    typingIndicator?.classList.remove('hidden');
    if (chatMessages) chatMessages.scrollTop = chatMessages.scrollHeight;

    // Brief pause so the exchange reads as a conversation rather than a jump cut.
    window.setTimeout(() => {
      typingIndicator?.classList.add('hidden');
      const topic = forced ?? findTopic(message);
      addMessage(topic ? topic.answer : FALLBACK, 'ai');
      isProcessing = false;
      if (sendBtn) sendBtn.disabled = false;
      if (chatMessages) chatMessages.scrollTop = chatMessages.scrollHeight;
    }, 350);
  }

  function formatMessageContent(text: string, sender: string): string {
    // Escape everything first; nothing here is trusted as HTML.
    let safe = text.replace(/</g, '&lt;').replace(/>/g, '&gt;');

    if (sender === 'ai') {
      // **bold**
      safe = safe.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
      // [label](/path) — relative links only, so nothing can point off-site.
      safe = safe.replace(/\[([^\]]+)\]\((\/[^)]*)\)/g, (_m, label, url) => {
        return '<a href="' + url + '" target="_self" rel="noopener">' + label + '</a>';
      });
      safe = safe.replace(/\n/g, '<br>');
    }
    return safe;
  }

  function addMessage(text: string, sender: string) {
    const messageDiv = document.createElement('div');
    messageDiv.className = 'message ' + sender;
    messageDiv.innerHTML =
      '<div class="message-content">' + formatMessageContent(text, sender) + '</div>' +
      '<span class="message-time">' +
      new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) +
      '</span>';
    chatMessages?.appendChild(messageDiv);
    if (chatMessages) chatMessages.scrollTop = chatMessages.scrollHeight;
  }

  wireQuickReplies();
</script>
