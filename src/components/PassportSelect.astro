---
import passports from '../data/passports.json';

// One select, shared by all three planners, reading one list.
//
// Deliberately optional and deliberately NOT inside the email form: it is the
// persona question, so it needs answering by everyone who uses a planner, not
// only by the people who hand over an address. A required field on a free tool
// costs more usage than the answer is worth.
//
// The value is read by ToolCapture at submit time via this id, and is sent
// nowhere else. No analytics on it in this branch.
const { label = 'Which passport are you travelling on?' } = Astro.props;
---

<label class="passport">
  <span class="passport__label">{label} <em>Optional</em></span>
  <select id="tool-passport" name="passport" autocomplete="country-name">
    <option value="" selected>Prefer not to say</option>
    {passports.priority.map(c => <option value={c}>{c}</option>)}
    <option disabled>──────────</option>
    {passports.rest.map(c => <option value={c}>{c}</option>)}
    <option value="Other">Other</option>
  </select>
  <span class="passport__why">
    It changes which rules apply to you. We use it to work out which guides to write next.
  </span>
</label>

<style>
  .passport { display: block; margin-top: var(--space-4); }
  .passport__label {
    display: block;
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }
  .passport__label em {
    font-style: normal;
    font-weight: var(--font-normal);
    color: var(--color-text-light);
  }
  .passport select {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-alt);
    font-size: var(--text-base);
    color: var(--color-text);
    transition: border-color var(--transition-fast), background var(--transition-fast);
  }
  .passport select:focus {
    outline: none;
    background: var(--color-surface);
    border-color: var(--color-primary);
  }
  .passport__why {
    display: block;
    font-size: var(--text-xs);
    line-height: var(--leading-relaxed);
    color: var(--color-text-light);
    margin-top: var(--space-2);
  }
</style>
