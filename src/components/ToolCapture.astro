---
// Email capture for the planners. Shared by all three so there is one form,
// one provider and one place to change any of it.
//
// Rules this implements, from BUILD-BRIEF-001 section 1b:
// - the planner works fully without an address; nothing is gated
// - asked once, after a result is on screen, never before it
// - one field plus the passport value already chosen elsewhere on the page
// - honest button copy that says what actually arrives
// - success replaces the form in place, the result is never navigated away from
// - failure says so plainly and leaves the address in the field
// - no pop up, no overlay, no timed modal, no second ask
//
// PROVIDER: see the adapter in the script below. Swapping to Brevo means
// editing one function there and nothing else in the codebase.
export interface Props {
  /** Identifies which planner sent the address. Arrives in the notification. */
  source: string;
  /** What the visitor just produced, used in the heading. */
  resultNoun?: string;
}
const { source, resultNoun = 'breakdown' } = Astro.props;
---

<section class="capture" data-source={source} aria-labelledby={`capture-h-${source}`}>
  <div class="capture__inner" id={`capture-form-${source}`}>
    <h2 class="capture__title" id={`capture-h-${source}`}>Want this {resultNoun} in your inbox?</h2>
    <p class="capture__body">
      We will send you a copy, and a short note when Europe's border rules actually change.
      Nothing else.
    </p>

    <form class="capture__form" novalidate>
      <label class="sr-only" for={`capture-email-${source}`}>Your email address</label>
      <input
        type="email"
        id={`capture-email-${source}`}
        class="capture__input"
        placeholder="you@example.com"
        autocomplete="email"
        required
      />
      <button type="submit" class="btn btn--primary capture__btn">
        Send me the {resultNoun}
      </button>
    </form>

    <p class="capture__terms">
      One email with your {resultNoun}, then only when the rules change. Unsubscribe in one click,
      any time. We do not share your address.
    </p>
    <p class="capture__error" role="alert" hidden></p>
  </div>

  <div class="capture__done" id={`capture-done-${source}`} hidden>
    <p class="capture__done-title">Sent. Check your inbox.</p>
    <p class="capture__done-body">
      If it is not there in a few minutes, look in spam and mark it as not spam, otherwise the
      border rule notes will end up there too.
    </p>
  </div>
</section>

<style>
  .capture {
    margin-top: var(--space-8);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-accent);
    border-radius: var(--radius-lg);
    background: var(--color-bg-alt);
  }
  .capture__title {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    color: var(--color-navy);
    margin-bottom: var(--space-2);
  }
  .capture__body {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
    max-width: 56ch;
  }
  .capture__form { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .capture__input {
    flex: 1 1 16rem;
    min-width: 0;
    padding: 11px 13px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    font-size: var(--text-base);
    color: var(--color-text);
  }
  .capture__input:focus { outline: none; border-color: var(--color-primary); }
  .capture__input[aria-invalid='true'] { border-color: var(--color-error); }
  .capture__btn { flex: 0 0 auto; }
  .capture__btn[disabled] { opacity: 0.6; cursor: not-allowed; }
  .capture__terms {
    font-size: var(--text-xs);
    line-height: var(--leading-relaxed);
    color: var(--color-text-light);
    margin-top: var(--space-3);
    max-width: 60ch;
  }
  .capture__error {
    font-size: var(--text-sm);
    color: var(--color-error);
    margin-top: var(--space-3);
  }
  .capture__done-title {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    color: var(--color-navy);
    margin-bottom: var(--space-2);
  }
  .capture__done-body {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
    max-width: 56ch;
  }
</style>

<script>
  // ───────────────────────────────────────────────────────────────────────
  // PROVIDER ADAPTER
  //
  // Everything provider specific is in submitCapture. The contract is fixed:
  //
  //   submitCapture({ email, passport, source }) -> Promise<{ok, error?}>
  //
  // Currently: our own endpoint at /api/subscribe, which talks to Brevo with a
  // key that stays on the server. Nothing secret reaches the browser, which is
  // the whole reason this route exists rather than posting to Brevo directly.
  //
  // Same origin, so the existing connect-src 'self' already permits it and no
  // CSP change is needed.
  // ───────────────────────────────────────────────────────────────────────
  const ENDPOINT = '/api/subscribe';

  type CaptureInput = { email: string; passport: string; source: string };

  async function submitCapture(input: CaptureInput): Promise<{ ok: boolean; error?: string }> {
    try {
      const res = await fetch(ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(input),
      });
      const data = await res.json().catch(() => ({}) as { message?: string });
      if (!res.ok) return { ok: false, error: data.message ?? 'That did not go through.' };
      return { ok: true };
    } catch (e) {
      return { ok: false, error: 'network' };
    }
  }

  // ───────────────────────────────────────────────────────────────────────
  // Wiring. Provider agnostic below this line.
  // ───────────────────────────────────────────────────────────────────────
  document.querySelectorAll<HTMLElement>('.capture').forEach(block => {
    const source = block.dataset.source ?? 'unknown';
    const form = block.querySelector('form') as HTMLFormElement | null;
    const input = block.querySelector('.capture__input') as HTMLInputElement | null;
    const btn = block.querySelector('.capture__btn') as HTMLButtonElement | null;
    const err = block.querySelector('.capture__error') as HTMLElement | null;
    const formWrap = block.querySelector('.capture__inner') as HTMLElement | null;
    const done = block.querySelector('.capture__done') as HTMLElement | null;
    if (!form || !input || !btn) return;

    // Captured once, here, not at submit time. Reading it later meant a failed
    // validation restored a fallback label and permanently downgraded the
    // button text.
    const originalLabel = btn.textContent ?? 'Send it';

    const fail = (msg: string) => {
      if (err) { err.textContent = msg; err.hidden = false; }
      input.setAttribute('aria-invalid', 'true');
      btn.disabled = false;
      btn.textContent = originalLabel;
      // The address stays in the field on purpose, so nothing is retyped.
    };

    form.addEventListener('submit', async e => {
      e.preventDefault();
      const email = input.value.trim();
      if (err) err.hidden = true;
      input.removeAttribute('aria-invalid');

      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        fail('That does not look like an email address. Check it and try again.');
        return;
      }

      // Read the passport answer from elsewhere on the page. It is never
      // required, and an empty value is sent as "not given" rather than
      // blocking the submission.
      const passportEl = document.getElementById('tool-passport') as HTMLSelectElement | null;
      const passport = passportEl?.value ?? '';

      btn.disabled = true;
      btn.textContent = 'Sending...';

      const result = await submitCapture({ email, passport, source });

      if (result.ok) {
        if (formWrap) formWrap.hidden = true;
        if (done) done.hidden = false;
      } else {
        // The endpoint returns a message written for the visitor; prefer it,
        // and fall back only when the request never reached us.
        const msg =
          result.error && result.error !== 'network'
            ? result.error + ' Or email us from the contact page.'
            : 'That did not go through. Try again in a moment, or email us from the contact page.';
        fail(msg);
      }
    });
  });
</script>
